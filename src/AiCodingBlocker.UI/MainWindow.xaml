<Window x:Class="AiCodingBlocker.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Code Blocker"
        Width="460" Height="360"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.Resources>
        <!-- A Button drawn as a switch. Its look comes only from IsOn (the service's reply), never from the click. -->
        <Style x:Key="SwitchButton" TargetType="Button">
            <Setter Property="Width" Value="140" />
            <Setter Property="Height" Value="64" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="32" Background="#555555" />
                            <Ellipse x:Name="Knob" Width="52" Height="52" Margin="6,0"
                                     Fill="White" HorizontalAlignment="Left" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#2EA043" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel VerticalAlignment="Center" Margin="32">
        <TextBlock Text="AI Code Blocker"
                   FontSize="28" FontWeight="Bold" Foreground="White"
                   HorizontalAlignment="Center" />

        <TextBlock Text="Want to become a real developer? Stop vibe coding. Take matters into your own hands, step out of the AI bubble, and solve it yourself."
                   TextWrapping="Wrap" TextAlignment="Center"
                   FontSize="14" Foreground="#CCCCCC"
                   Margin="0,16,0,28" />

        <Button Style="{StaticResource SwitchButton}"
                Command="{Binding ToggleCommand}"
                AutomationProperties.Name="Focus Mode toggle" />

        <TextBlock Text="{Binding StatusText}"
                   FontSize="13" Foreground="#CCCCCC"
                   HorizontalAlignment="Center" Margin="0,12,0,0" />
    </StackPanel>
</Window>
